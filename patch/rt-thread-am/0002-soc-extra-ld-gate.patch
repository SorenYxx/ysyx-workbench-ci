Content-Transfer-Encoding: 8bit

SoC 路径（ysyxsoc.ld）已内嵌 RT-Thread/am_apps section，不再链接 extra.ld；
nemu/npc 仍走 flat linker.ld + extra.ld。原 CONFIG_SOC 门控在链接期为空，
改为按 ARCH 是否含 ysyxsoc 判断。

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 bsp/abstract-machine/Makefile | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 29993c9a0..51ae6b0eb 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -8,11 +8,13 @@ NAME = rtthread
 SRCS = $(shell find src -name "*.c")
 CFLAGS += -DHAVE_CCONFIG_H -D__RTTHREAD__
 CFLAGS += -Wno-nonnull-compare
-ifeq ($(CONFIG_SOC), n)
-  -LDFLAGS += -T extra.ld
+
+ifneq ($(findstring ysyxsoc,$(ARCH)),)
+  LDFLAGS +=
 else
-  -LDFLAGS +=
+  LDFLAGS += -T extra.ld
 endif
+
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
 include $(AM_HOME)/Makefile
