+module sdram_bit32(
+  input        clk,
+  input        cke,
+  input        cs,   // 片选, 低有效
+  input        ras,  // 行地址选通
+  input        cas,  // 列地址选通
+  input        we,   // 写使能
+  input [12:0] a,    // 地址总线 (行/列/模式复用)
+  input [ 1:0] ba,   // bank 地址
+  input [ 3:0] dqm,  // 字节掩码 (高=屏蔽对应字节)
+  inout [31:0] dq    // 数据总线
+);
+
+  sdram u0(
+    .clk(clk),
+    .cke(cke),
+    .cs(cs),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[1:0]),
+    .dq(dq[15:0])
+  );
+  
+  sdram u1(
+    .clk(clk),
+    .cke(cke),
+    .cs(cs),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[3:2]),
+    .dq(dq[31:16])
+  );
+
+endmodule
