diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..2bb09c11 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -31,8 +31,63 @@ module apb_delayer(
   assign out_pwrite  = in_pwrite;
   assign out_pwdata  = in_pwdata;
   assign out_pstrb   = in_pstrb;
-  assign in_pready   = out_pready;
   assign in_prdata   = out_prdata;
   assign in_pslverr  = out_pslverr;
 
+  parameter integer r    = 500 / 100;   // 处理器频率 / 设备频率
+  parameter integer s    = 1;    // 用于处理 r 为小数时的放大系数
+  parameter integer base = r * s; // 硬编码常数
+
+  reg [ 1:0] state;
+  reg [31:0] counter;
+
+  localparam IDLE  = 2'b00;
+  localparam WAIT  = 2'b01;
+  localparam DELAY = 2'b10;
+
+  wire start  = in_psel && !in_penable;
+  wire finish = out_pready;
+
+  reg pready;
+
+  always @(posedge clock, posedge reset) begin
+    if (reset) begin
+      state <= IDLE;
+      counter <= 32'b0;
+    end
+    else begin
+      case (state)
+        IDLE: begin
+        pready <= 1'b0;
+          if (start) begin
+            state   <= WAIT;
+            counter <= base;
+          end
+        end
+
+        WAIT: begin
+          pready <= 1'b0;
+          if (finish) begin
+            state   <= DELAY;
+            counter <= counter >> $clog2(s);
+          end else begin
+            counter <= counter + base;
+          end
+        end
+
+        DELAY: begin
+        pready <= 1'b0;
+          if (counter == 1) begin
+            pready <= 1'b1;
+            state  <= IDLE;
+          end
+          else counter <= counter - 1;
+        end
+        default: state <= IDLE;
+      endcase
+    end
+  end
+
+  assign in_pready = pready;
+
 endmodule
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..841084cd 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -63,34 +63,177 @@ module axi4_delayer(
   input  [1:0]  out_bresp
 );
 
-  assign in_arready = out_arready;
+  // ----- AR / AW / W 直通 -----
   assign out_arvalid = in_arvalid;
-  assign out_arid = in_arid;
-  assign out_araddr = in_araddr;
-  assign out_arlen = in_arlen;
-  assign out_arsize = in_arsize;
+  assign out_arid    = in_arid;
+  assign out_araddr  = in_araddr;
+  assign out_arlen   = in_arlen;
+  assign out_arsize  = in_arsize;
   assign out_arburst = in_arburst;
-  assign out_rready = in_rready;
-  assign in_rvalid = out_rvalid;
-  assign in_rid = out_rid;
-  assign in_rdata = out_rdata;
-  assign in_rresp = out_rresp;
-  assign in_rlast = out_rlast;
-  assign in_awready = out_awready;
+  assign in_arready  = out_arready;
+
   assign out_awvalid = in_awvalid;
-  assign out_awid = in_awid;
-  assign out_awaddr = in_awaddr;
-  assign out_awlen = in_awlen;
-  assign out_awsize = in_awsize;
+  assign out_awid    = in_awid;
+  assign out_awaddr  = in_awaddr;
+  assign out_awlen   = in_awlen;
+  assign out_awsize  = in_awsize;
   assign out_awburst = in_awburst;
-  assign in_wready = out_wready;
-  assign out_wvalid = in_wvalid;
-  assign out_wdata = in_wdata;
-  assign out_wstrb = in_wstrb;
-  assign out_wlast = in_wlast;
-  assign out_bready = in_bready;
-  assign in_bvalid = out_bvalid;
-  assign in_bid = out_bid;
-  assign in_bresp = out_bresp;
+  assign in_awready  = out_awready;
+
+  assign out_wvalid  = in_wvalid;
+  assign out_wdata   = in_wdata;
+  assign out_wstrb   = in_wstrb;
+  assign out_wlast   = in_wlast;
+  assign in_wready   = out_wready;
+
+  assign out_rready  = in_rready;
+  assign out_bready  = in_bready;
+  // ----------------------------
+
+  localparam RBUF_DEPTH = 4;  // burst 拍数 ≤ 8 (icache 当前 4 拍)
+
+  parameter integer r    = 500 / 100;   // 处理器频率 / 设备频率
+  parameter integer s    = 1;     // r 为整数时 s=1
+  parameter integer base = r * s;
+
+  // 全局周期计数器
+  reg [31:0] cycle_cnt;
+  always @(posedge clock, posedge reset) begin
+    if (reset) cycle_cnt <= 32'b0;
+    else       cycle_cnt <= cycle_cnt + 1;
+  end
+
+  // ----- R channel 延迟处理 -----
+
+  reg [31:0] rd_start;
+  reg        rd_active;
+
+  wire handshake_ar = in_arvalid && in_arready;
+  wire handshake_r  = in_rvalid && in_rready;
+
+  always @(posedge clock, posedge reset) begin
+    if (reset) begin
+      rd_start  <= 32'b0;
+      rd_active <= 1'b0;
+    end else begin
+      if (handshake_ar) begin
+        rd_start  <= cycle_cnt;
+        rd_active <= 1'b1;
+      end else if (rd_active && in_rlast && handshake_r) begin
+        rd_active <= 1'b0;
+        rbuf_wptr <= 2'b0;
+        rbuf_rptr <= 2'b0;
+        cnt_in    <= 3'b0;
+        cnt_out   <= 3'b0;
+      end
+    end
+  end
+
+  // ----- R beat buffer -----
+  reg [31:0] rbuf_data  [RBUF_DEPTH-1:0];
+  reg [ 3:0] rbuf_id    [RBUF_DEPTH-1:0];
+  reg [ 1:0] rbuf_resp  [RBUF_DEPTH-1:0];
+  reg        rbuf_last  [RBUF_DEPTH-1:0];
+  reg [31:0] rbuf_delay [RBUF_DEPTH-1:0]; // extra_delay 倒计时
+
+  reg [ 1:0] rbuf_wptr, rbuf_rptr; // buf 读/写指针
+  reg [ 2:0] rbuf_cnt, cnt_in, cnt_out; // buf 计数器 (防止 push 和 pop 同时有效造成的奇妙 bug)
+
+  wire rd_push = out_rvalid && out_rready && (rbuf_cnt < RBUF_DEPTH); // 下游握手 push
+  wire rd_pop  = (rbuf_cnt > 0) && (rbuf_delay[rbuf_rptr] == 0) && in_rready; // 校准完成 pop
+
+  integer i;
+  always @(posedge clock, posedge reset) begin
+    if (reset) begin
+      rbuf_wptr <= 2'b0;
+      rbuf_rptr <= 2'b0;
+      cnt_in    <= 3'b0;
+      cnt_out   <= 3'b0;
+      for (i = 0; i < RBUF_DEPTH; i = i + 1) begin
+        rbuf_data [i] <= 32'b0;
+        rbuf_id   [i] <= 4'b0;
+        rbuf_resp [i] <= 2'b0;
+        rbuf_last [i] <= 1'b0;
+        rbuf_delay[i] <= 32'b0;
+      end
+    end else begin
+      for (i = 0; i < RBUF_DEPTH; i = i + 1)
+        if (rbuf_delay[i] > 0) rbuf_delay[i] <= rbuf_delay[i] - 1;
+
+      // push
+      if (rd_push) begin
+        rbuf_data [rbuf_wptr] <= out_rdata;
+        rbuf_id   [rbuf_wptr] <= out_rid;
+        rbuf_resp [rbuf_wptr] <= out_rresp;
+        rbuf_last [rbuf_wptr] <= out_rlast;
+        rbuf_delay[rbuf_wptr] <= (cycle_cnt - rd_start) * (r - 1); // 整数
+        rbuf_wptr <= rbuf_wptr + 1;
+        cnt_in <= cnt_in + 1;
+      end
+
+      // pop
+      if (rd_pop) begin
+        rbuf_rptr <= rbuf_rptr + 1;
+        cnt_out   <= cnt_out + 1;
+      end
+    end
+  end
+
+  // 向上游输出
+  assign rbuf_cnt  = cnt_in - cnt_out;
+  assign in_rvalid = (rbuf_cnt > 0) && (rbuf_delay[rbuf_rptr] == 0);
+  assign in_rdata  = rbuf_data [rbuf_rptr];
+  assign in_rid    = rbuf_id   [rbuf_rptr];
+  assign in_rresp  = rbuf_resp [rbuf_rptr];
+  assign in_rlast  = rbuf_last [rbuf_rptr];
+
+
+
+  // ----- B channel 延迟处理 (no burst) -----
+
+  reg [31:0] wr_start;
+  reg        wr_active;
+  reg [31:0] b_delay;        // B 响应剩余延迟
+  reg        b_buf;     // 是否已缓冲 B 响应
+  reg [ 3:0] b_id;
+  reg [ 1:0] b_resp;
+
+  wire handshake_aw = in_awvalid && in_awready;
+  wire handshake_b  = out_bvalid && out_bready && !b_buf;
+
+  always @(posedge clock, posedge reset) begin
+    if (reset) begin
+      wr_start  <= 32'b0;
+      wr_active <= 1'b0;
+      b_delay   <= 32'b0;
+      b_buf     <= 1'b0;
+      b_id      <= 4'b0;
+      b_resp    <= 2'b0;
+    end else begin
+      if (handshake_aw) begin
+        wr_start  <= cycle_cnt;
+        wr_active <= 1'b1;
+      end
+
+      if (handshake_b) begin
+        b_id    <= out_bid;
+        b_resp  <= out_bresp;
+        b_delay <= (cycle_cnt - wr_start) * (r - 1);
+        b_buf   <= 1'b1;
+      end
+
+      if (b_delay > 0) b_delay <= b_delay - 1;
+
+      if (b_buf && b_delay == 0 && in_bready) begin
+        b_buf <= 1'b0;
+        wr_active <= 1'b0;
+      end
+    end
+  end
+
+  // 向上游输出 B
+  assign in_bvalid = b_buf && (b_delay == 0);
+  assign in_bid    = b_id;
+  assign in_bresp  = b_resp;
 
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..6a93ae37 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -24,4 +24,73 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_7
 );
 
+  reg [15:0] led_data;
+  reg [15:0] switch_data;
+  reg [31:0] seg_data;
+
+	wire [7:0] segs [15:0];
+	assign segs[0]  = 8'b11111101;
+	assign segs[1]  = 8'b01100000;
+	assign segs[2]  = 8'b11011010;
+	assign segs[3]  = 8'b11110010;
+	assign segs[4]  = 8'b01100110;
+	assign segs[5]  = 8'b10110110;
+	assign segs[6]  = 8'b10111110;
+	assign segs[7]  = 8'b11100000;
+	assign segs[8]  = 8'b11111110;
+	assign segs[9]  = 8'b11110110;
+  assign segs[10] = 8'b11101110;
+  assign segs[11] = 8'b00111110;
+  assign segs[12] = 8'b10011100;
+  assign segs[13] = 8'b01111010;
+  assign segs[14] = 8'b10011110;
+  assign segs[15] = 8'b10001110;
+
+  assign gpio_seg_0 = ~segs[seg_data[3:0]];
+  assign gpio_seg_1 = ~segs[seg_data[7:4]];
+  assign gpio_seg_2 = ~segs[seg_data[11:8]];
+  assign gpio_seg_3 = ~segs[seg_data[15:12]];
+  assign gpio_seg_4 = ~segs[seg_data[19:16]];
+  assign gpio_seg_5 = ~segs[seg_data[23:20]];
+  assign gpio_seg_6 = ~segs[seg_data[27:24]];
+  assign gpio_seg_7 = ~segs[seg_data[31:28]];
+
+  assign in_pready = in_psel && in_penable;
+  assign gpio_out  = led_data;
+
+  reg        pslverr_q;
+  reg [31:0] prdata_q;
+
+  assign in_pslverr = pslverr_q;
+  assign in_prdata  = prdata_q;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      led_data    <= 16'b0;
+      seg_data    <= 32'b0;
+      switch_data <= 16'b0;
+      pslverr_q   <= 1'b0;
+      prdata_q    <= 32'b0;
+    end
+    else if (in_psel && in_penable) begin
+      switch_data <= gpio_in;
+      if (in_pwrite) begin
+        case(in_paddr[3:0])
+          4'h0: led_data <= in_pwdata[15:0];
+          4'h8: seg_data <= in_pwdata;
+          4'hc: ;
+          default: pslverr_q <= 1'b1;
+        endcase
+      end
+      else
+        case(in_paddr[3:0])
+          4'h0: prdata_q <= {16'b0, led_data};
+          4'h4: prdata_q <= {16'b0, switch_data};
+          4'h8: prdata_q <= seg_data;
+          4'hc: ;
+          default: pslverr_q <= 1'b1;
+        endcase
+    end
+  end
+
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..7af6b4d4 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,4 +16,42 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+reg [2:0] ps2_clk_sync;
+reg [9:0] buffer;
+reg [3:0] count;
+
+// 检测下降沿
+always @(posedge clock) begin
+  ps2_clk_sync <= {ps2_clk_sync[1:0], ps2_clk};
+end
+
+wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+always @(posedge clock) begin
+  if (reset) begin
+    count  <= 4'd0;
+    buffer <= 10'd0;
+    prdata <= 32'd0;
+  end
+  else begin
+    if (sampling) begin
+      if(count == 4'd10) begin
+        if(buffer[0] == 1'b0 && ps2_data == 1'b1 && (^buffer[9:1])) begin
+          prdata <= {24'd0, buffer[8:1]};
+        end
+        count  <= 4'd0;
+      end
+      else begin
+        buffer[count] <= ps2_data;
+        count         <= count + 4'd1;
+      end
+    end
+  end
+end
+
+reg [31:0] prdata;
+assign in_prdata = in_pready ? prdata : 32'd0;
+assign in_pready = in_psel && in_penable;
+assign in_pslverr = 1'b0;
+
 endmodule
