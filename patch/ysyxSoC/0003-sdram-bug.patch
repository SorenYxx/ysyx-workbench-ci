+++ b/perip/spi/rtl/spi_top_apb.v
@@ -71,7 +71,7 @@ spi_top u0_spi_top (
   .miso_pad_i(spi_miso)
 );
 
-// ----- XPI 状态机 -----
+// ----- XIP 状态机 -----
 reg [ 3:0] xip_state;
 reg [31:0] xip_rdata;
 
